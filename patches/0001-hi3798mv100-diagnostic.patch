+			 state.ehci_hccparams, state.ohci_revision);
+	else
+		dev_info(dev, "USB_AUDIT_CAPABILITIES_SKIPPED inherited-state-not-ready\n");
+	dev_info(dev, "USB_AUDIT_READ_ONLY_COMPLETE no-clock-reset-writes no-device-transactions\n");
+	return 0;
