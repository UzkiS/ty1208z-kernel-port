+++ b/drivers/mmc/host/dw_mmc-hi3798mv100-ident.c
@@ -0,0 +1,162 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Restricted RAM diagnostic, not the production MV100 storage driver. */
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/mmc/host.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "dw_mmc.h"
+#include "dw_mmc-pltfm.h"
+#include "hi3798mv100-ident-policy.h"
+
+static int mv100_ident_init(struct dw_mci *host)
+{
+	if (host->bus_hz != 100000000 || host->pdata->fifo_depth != 256 ||
+	    mci_readl(host, VERID) != 0x5342270a ||
+	    mci_readl(host, HCON) != 0x00e44c81)
+		return -ENODEV;
+
+	/* PIO bypasses dw_mci_idmac_init(), including its inherited-IRQ cleanup.
+	 * Quiesce the measured 32-bit IDMAC before request_irq enables the GIC line.
+	 * This changes only controller state, not card settings or storage contents.
+	 */
+	dev_info(host->dev,
+		 "EMMC_IDENT_INHERITED CTRL=%08x BMOD=%08x IDINTEN=%08x IDSTS=%08x RINTSTS=%08x\n",
+		 mci_readl(host, CTRL), mci_readl(host, BMOD),
+		 mci_readl(host, IDINTEN), mci_readl(host, IDSTS),
+		 mci_readl(host, RINTSTS));
+	mci_writel(host, INTMASK, 0);
+	mci_writel(host, IDINTEN, 0);
+	mci_writel(host, BMOD, mci_readl(host, BMOD) & ~SDMMC_IDMAC_ENABLE);
+	mci_writel(host, CTRL, mci_readl(host, CTRL) &
+		   ~(SDMMC_CTRL_INT_ENABLE | SDMMC_CTRL_DMA_ENABLE |
+		     SDMMC_CTRL_USE_IDMAC));
+	mci_writel(host, IDSTS, SDMMC_IDMAC_INT_AI | SDMMC_IDMAC_INT_NI |
+		   SDMMC_IDMAC_INT_CES | SDMMC_IDMAC_INT_DU |
+		   SDMMC_IDMAC_INT_FBE | SDMMC_IDMAC_INT_RI | SDMMC_IDMAC_INT_TI);
+	mci_writel(host, RINTSTS, 0xffffffff);
+	dev_info(host->dev,
+		 "EMMC_IDENT_PIO_QUIESCED CTRL=%08x BMOD=%08x IDINTEN=%08x IDSTS=%08x\n",
+		 mci_readl(host, CTRL), mci_readl(host, BMOD),
+		 mci_readl(host, IDINTEN), mci_readl(host, IDSTS));
+
+	dev_info(host->dev, "EMMC_IDENT_GUARD_PASS source=100000000 PIO-only\n");
+	return 0;
+}
+
+static int mv100_ident_slot(struct dw_mci_slot *slot)
+{
+	struct mmc_host *mmc = slot->mmc;
+
+	/* Override all DT/core capabilities before mmc_add_host can enumerate. */
+	mmc->caps = MMC_CAP_NONREMOVABLE;
+	mmc->caps2 = MMC_CAP2_NO_SD | MMC_CAP2_NO_SDIO;
+	mmc->pm_caps = 0;
+	mmc->f_max = 25000000;
+	mmc->max_blk_size = 512;
+	mmc->max_blk_count = 1;
+	mmc->max_req_size = 512;
+	mmc->max_seg_size = 512;
+	mmc->dsr_req = 0;
+	return 0;
+}
+
+static int mv100_ident_validate(struct dw_mci *host, struct mmc_request *mrq)
+{
+	int ret = hi3798mv100_ident_request(mrq);
+
+	if (ret)
+		dev_info_ratelimited(host->dev,
+			"EMMC_IDENT_BLOCKED CMD%u arg=%08x error=%d\n",
+			mrq->cmd->opcode, mrq->cmd->arg, ret);
+	else if (mrq->cmd->opcode == MMC_SEND_OP_COND)
+		dev_info_ratelimited(host->dev, "EMMC_IDENT_CMD1 arg=%08x\n",
+				     mrq->cmd->arg);
+	return ret;
+}
+
+static int mv100_ident_voltage(struct mmc_host *mmc, struct mmc_ios *ios)
+{
+	/* Retain the inherited I/O voltage; never change regulators/UHS voltage. */
+	return ios->signal_voltage == MMC_SIGNAL_VOLTAGE_330 ? 0 : -EPERM;
+}
+
+static const struct dw_mci_drv_data mv100_ident_data = {
+	.init = mv100_ident_init,
+	.init_slot = mv100_ident_slot,
+	.validate_request = mv100_ident_validate,
+	.switch_voltage = mv100_ident_voltage,
+	.force_pio = true,
+};
+
+static int mv100_ident_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct resource *controller, *crg;
+	struct irq_data *irq_data;
+	void __iomem *regs, *crg40;
+	u32 value;
+	int irq;
+
+	controller = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	crg = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!controller || controller->start != 0xf9830000 ||
+	    resource_size(controller) != 0x1000 || !crg ||
+	    crg->start != 0xf8a220a0 || resource_size(crg) != 4)
+		return -EINVAL;
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	irq_data = irq_get_irq_data(irq);
+	if (!irq_data || irq_data->hwirq != 67)
+		return -EINVAL;
+
+	/* Inherit measured pinmux/CRG; no clock/reset/power provider is called. */
+	if (of_find_property(dev->of_node, "clocks", NULL) ||
+	    of_find_property(dev->of_node, "resets", NULL) ||
+	    of_find_property(dev->of_node, "mmc-pwrseq", NULL) ||
+	    of_find_property(dev->of_node, "vmmc-supply", NULL) ||
+	    of_find_property(dev->of_node, "vqmmc-supply", NULL))
+		return -EINVAL;
+
+	crg40 = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(crg40))
+		return PTR_ERR(crg40);
+	value = readl(crg40);
+	if (value != 0x00040103)
+		return dev_err_probe(dev, -ENODEV, "Unexpected inherited CRG40=%08x\n", value);
+
+	/* Check the measured identity before the generic driver can write MMIO. */
+	regs = devm_ioremap(dev, controller->start, resource_size(controller));
+	if (!regs)
+		return -ENOMEM;
+	value = readl(regs + SDMMC_VERID);
+	if (value != 0x5342270a || readl(regs + SDMMC_HCON) != 0x00e44c81) {
+		devm_iounmap(dev, regs);
+		return -ENODEV;
+	}
+	devm_iounmap(dev, regs);
+
+	return dw_mci_pltfm_register(pdev, &mv100_ident_data);
+}
+
+static const struct of_device_id mv100_ident_match[] = {
+	{ .compatible = "tianyi,ty1208z-emmc-identification" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mv100_ident_match);
+
+static struct platform_driver mv100_ident_driver = {
+	.probe = mv100_ident_probe,
+	.remove_new = dw_mci_pltfm_remove,
+	.driver = {
+		.name = "hi3798mv100-emmc-ident",
+		.of_match_table = mv100_ident_match,
+	},
+};
+module_platform_driver(mv100_ident_driver);
+MODULE_DESCRIPTION("TY1208Z restricted PIO eMMC identification diagnostic");
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/mmc/host/hi3798mv100-ident-policy.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef HI3798MV100_IDENT_POLICY_H
+#define HI3798MV100_IDENT_POLICY_H
+
+#include <linux/errno.h>
+#include <linux/mmc/core.h>
+#include <linux/mmc/mmc.h>
+#include <linux/mmc/ty1208z-samples.h>
+
+/* Identification plus optional fixed read samples. No settings or data writes. */
+static inline int hi3798mv100_ident_request(struct mmc_request *mrq)
+{
+	struct mmc_command *cmd = mrq->cmd;
+	struct mmc_data *data = mrq->data;
+
+	if (!cmd || mrq->sbc || mrq->stop)
+		return -EPERM;
+	if (cmd->data != data || (data && data->stop))
+		return -EPERM;
+	if (data) {
+		if (data->flags != MMC_DATA_READ || data->blocks != 1 ||
+		    data->blksz != 512)
+			return -EPERM;
+		if (cmd->opcode == MMC_SEND_EXT_CSD && cmd->arg == 0)
+			return 0;
+#ifdef CONFIG_HI3798MV100_EMMC_READ_SAMPLES
+		if (cmd->opcode == MMC_READ_SINGLE_BLOCK && ty1208z_sample_sector(cmd->arg))
+			return 0;
+#endif
+		return -EPERM;
+	}
+
+	/* Core treats -EBADMSG as an unsupported optional card setting. */
+	if (cmd->opcode == MMC_SWITCH)
+		return -EBADMSG;
+
+	switch (cmd->opcode) {
+	case MMC_GO_IDLE_STATE:
+	case MMC_ALL_SEND_CID:
+		return cmd->arg == 0 ? 0 : -EPERM;
+	case MMC_SEND_OP_COND:
+		/* Core repeats a busy OCR query using the card's advertised OCR.
+		 * Dual-voltage eMMC includes bit 7, even with the host kept at 3.3 V.
+		 * This is CMD1 negotiation, not an I/O-voltage switch or card setting.
+		 */
+		return cmd->arg & ~0x40ff8080U ? -EPERM : 0;
+	case MMC_SET_RELATIVE_ADDR:
+	case MMC_SEND_CSD:
+	case MMC_SEND_CID:
+	case MMC_SEND_STATUS:
+		return cmd->arg == 0x00010000 ? 0 : -EPERM;
+	case MMC_SELECT_CARD:
+		return cmd->arg == 0 || cmd->arg == 0x00010000 ? 0 : -EPERM;
+	default:
+		return -EPERM;
+	}
+}
+
+#endif
--- /dev/null
+++ b/drivers/soc/hisilicon/hi3798mv100-emmc-audit.c
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Read-only controller identification before any MMC driver is enabled. */
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+static int hi3798mv100_emmc_audit_probe(struct platform_device *pdev)
+{
+	static const unsigned int rates[] = { 75000000, 100000000,
+					      50000000, 15000000 };
+	static const struct {
+		const char *name;
+		u32 offset;
+	} registers[] = {
+		{ "CLKDIV", 0x08 }, { "CLKSRC", 0x0c }, { "CLKENA", 0x10 },
+		{ "CTYPE", 0x18 }, { "FIFOTH", 0x4c }, { "USRID", 0x68 },
+		{ "VERID", 0x6c }, { "HCON", 0x70 },
+	};
+	struct device *dev = &pdev->dev;
+	void __iomem *controller, *crg;
+	struct resource *res;
+	u32 value;
+	unsigned int i;
+
+	if (!of_machine_is_compatible("tianyi,ty1208z-ca-diagnostic"))
+		return -ENODEV;
+	/* Fixed measured resources; never expose arbitrary physical access. */
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0xf9830000 || resource_size(res) != 0x1000)
+		return -EINVAL;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+	if (!res || res->start != 0xf8a220a0 || resource_size(res) != 4)
+		return -EINVAL;
+	controller = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(controller))
+		return PTR_ERR(controller);
+	crg = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(crg))
+		return PTR_ERR(crg);
+
+	/* No FIFO/status reads, clock/reset changes or MMC commands. */
+	for (i = 0; i < ARRAY_SIZE(registers); i++)
+		dev_info(dev, "EMMC_AUDIT %s=%08x\n", registers[i].name,
+			 readl(controller + registers[i].offset));
+	value = readl(crg);
+	dev_info(dev, "EMMC_AUDIT CRG40=%08x sdk_source_hz=%u\n",
+		 value, rates[(value >> 8) & 3]);
+	dev_info(dev, "EMMC_AUDIT_READ_ONLY_COMPLETE\n");
+	return 0;
+}
+
+static const struct of_device_id hi3798mv100_emmc_audit_match[] = {
+	{ .compatible = "tianyi,ty1208z-emmc-register-audit" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_emmc_audit_match);
+
+static struct platform_driver hi3798mv100_emmc_audit_driver = {
+	.probe = hi3798mv100_emmc_audit_probe,
+	.driver = {
+		.name = "hi3798mv100-emmc-audit",
+		.of_match_table = hi3798mv100_emmc_audit_match,
+	},
+};
+builtin_platform_driver(hi3798mv100_emmc_audit_driver);
+MODULE_LICENSE("GPL");
--- /dev/null
+++ b/drivers/soc/hisilicon/hi3798mv100-ethernet-audit.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Observe inherited Ethernet state; never initialize MAC, clocks or PHY. */
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "ty1208z-ethernet-audit.h"
+
+static int hi3798mv100_ethernet_audit_probe(struct platform_device *pdev)
+{
+	static const struct {
+		resource_size_t address;
+		resource_size_t size;
+		const char *name;
+	} resources[] = {
+		{ 0xf9840000, 0x4000, "MAC" },
+		{ 0xf8a220cc, 4, "CRG51" },
+		{ 0xf8a22120, 4, "PHY_CRG" },
+		{ 0xf8a20008, 4, "PHY_SELECT" },
+		{ 0xf8a20118, 4, "PHY_ADDRESS" },
+		{ 0xf8a20844, 4, "PHY_LDO" },
+	};
+	static const struct {
+		const char *name;
+		u32 offset;
+	} registers[] = {
+		{ "PORT_MODE", 0x200 }, { "PORT_STATUS", 0x208 },
+		{ "QUEUE_CONFIG", 0x344 }, { "QUEUE_STATUS", 0x36c },
+		{ "SOFT_RESET", 0x1308 }, { "FWCTRL", 0x1310 },
+		{ "IRQ_STATUS", 0x1330 }, { "IRQ_ENABLE", 0x1334 },
+		{ "IRQ_RAW", 0x1338 }, { "MDIO_CONTROL", 0x1100 },
+	};
+	struct device *dev = &pdev->dev;
+	void __iomem *mapped[ARRAY_SIZE(resources)];
+	u32 values[ARRAY_SIZE(resources)] = { 0 }, phy_id;
+	struct resource *res;
+	unsigned int i;
+	int ret;
+
+	if (!of_machine_is_compatible("tianyi,ty1208z-ca-diagnostic"))
+		return -ENODEV;
+	/* Reject any changed resource before mapping or touching the hardware. */
+	for (i = 0; i < ARRAY_SIZE(resources); i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res || res->start != resources[i].address ||
+		    resource_size(res) != resources[i].size)
+			return -EINVAL;
+	}
+	if (platform_get_resource(pdev, IORESOURCE_MEM, ARRAY_SIZE(resources)))
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(resources); i++) {
+		mapped[i] = devm_platform_ioremap_resource(pdev, i);
+		if (IS_ERR(mapped[i]))
+			return PTR_ERR(mapped[i]);
+	}
+	/* Control registers are observed before any access to the clocked MAC. */
+	for (i = 1; i < ARRAY_SIZE(resources); i++) {
+		values[i] = readl(mapped[i]);
+		dev_info(dev, "ETH_AUDIT %s=%08x\n", resources[i].name, values[i]);
+	}
+	if (!ty1208z_eth_inherited_ready(values[1], values[2], values[3], values[4])) {
+		dev_info(dev, "ETH_AUDIT_MDIO_SKIPPED inherited-state-not-ready\n");
+		goto complete;
+	}
+	/* No MAC address, FIFO/descriptors, read-to-clear PHY status or IRQ writes. */
+	for (i = 0; i < ARRAY_SIZE(registers); i++)
+		dev_info(dev, "ETH_AUDIT %s=%08x\n", registers[i].name,
+			 readl(mapped[0] + registers[i].offset));
+	ret = ty1208z_eth_read_phy_id(mapped[0] + 0x1100, &phy_id);
+	if (ret)
+		dev_info(dev, "ETH_AUDIT_PHY_ID_UNAVAILABLE error=%d\n", ret);
+	else
+		dev_info(dev, "ETH_AUDIT_PHY_ID addr=1 id=%08x\n", phy_id);
+complete:
+	dev_info(dev, "ETH_AUDIT_COMPLETE no-phy-writes no-clock-reset-writes no-dma\n");
+	return 0;
+}
+
+static const struct of_device_id hi3798mv100_ethernet_audit_match[] = {
+	{ .compatible = "tianyi,ty1208z-ethernet-audit" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, hi3798mv100_ethernet_audit_match);
+
+static struct platform_driver hi3798mv100_ethernet_audit_driver = {
+	.probe = hi3798mv100_ethernet_audit_probe,
+	.driver = {
+		.name = "hi3798mv100-ethernet-audit",
+		.of_match_table = hi3798mv100_ethernet_audit_match,
+	},
+};
+builtin_platform_driver(hi3798mv100_ethernet_audit_driver);
