+++ b/drivers/clk/hisilicon/ty1208z-usb-host0.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Independent implementation of the host0 register protocol documented by
+ * Hisilicon's 2014/2015 clk-hiusb2.c (Apache-2.0, Liu Hui).
+ * Register values/order are hardware protocol facts. No SDK C implementation
+ * is included here; the offline test executes the pinned original as oracle.
+ */
+#ifndef TY1208Z_USB_HOST0_H
+#define TY1208Z_USB_HOST0_H
+
+#include <linux/delay.h>
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+
+/* Five separately bounded mappings: CRG46, CRG47, USB0, USB1, SYSID0. */
+#define TY_USB_CONTROLLER_RESETS 0x00037000U
+#define TY_USB_CONTROLLER_CLOCKS 0x0000007fU
+#define TY_USB_PHY_RESETS 0x00000f00U
+#define TY_USB_PHY_POWER_RESETS 0x00000500U
+#define TY_USB_PHY_PORT_RESETS 0x00000a00U
+
+struct ty1208z_usb_phy_command {
+	u32 value;
+	unsigned int delay_us;
+};
+
+static inline void ty1208z_usb_phy_commands(void __iomem *port,
+			const struct ty1208z_usb_phy_command *commands,
+			unsigned int count)
+{
+	unsigned int i;
+
+	for (i = 0; i < count; i++) {
+		writel(commands[i].value, port);
+		if (commands[i].delay_us)
+			udelay(commands[i].delay_us);
+	}
+}
+
+/* The original SYSID0 low-byte revision decision does not require an OTP read. */
+static inline bool ty1208z_usb_revision_valid(u32 sysid0)
+{
+	return sysid0 != 0 && sysid0 != ~0U;
+}
+
+static inline int ty1208z_usb_host0_stop(void __iomem * const *controls)
+{
+	u32 value = readl(controls[1]);
+
+	writel(value | TY_USB_PHY_RESETS, controls[1]);
+	udelay(100);
+	/* Match host0 last-user shutdown; preserve all other clock/control bits. */
+	value = readl(controls[0]);
+	writel(value & ~0x71U, controls[0]);
+	udelay(200);
+	return (readl(controls[1]) & TY_USB_PHY_RESETS) == TY_USB_PHY_RESETS &&
+	       !(readl(controls[0]) & 0x71U) ? 0 : -EIO;
+}
+
+static inline int ty1208z_usb_host0_start(void __iomem * const *controls)
+{
+	static const struct ty1208z_usb_phy_command pll240[] = {
+		{ 0xa809, 0 }, { 0xe809, 0 }, { 0xa809, 300 },
+	};
+	static const struct ty1208z_usb_phy_command revision10[] = {
+		{ 0xa801, 0 }, { 0xe801, 0 }, { 0xa801, 300 },
+		{ 0xa604, 0 }, { 0xe604, 0 }, { 0xa604, 1000 },
+		{ 0xa01c, 0 }, { 0xe01c, 0 }, { 0xa01c, 0 },
+		{ 0xb01c, 0 }, { 0xf01c, 0 }, { 0xb01c, 100 },
+	};
+	static const struct ty1208z_usb_phy_command other_revision[] = {
+		{ 0xa73b, 0 }, { 0xe73b, 0 }, { 0xa73b, 500 },
+		{ 0xabc0, 0 }, { 0xebc0, 0 }, { 0xabc0, 500 },
+		{ 0xa73f, 0 }, { 0xe73f, 0 }, { 0xa73f, 1000 },
+		{ 0xabe0, 0 }, { 0xebe0, 0 }, { 0xabe0, 1000 },
+		{ 0xaa02, 0 }, { 0xea02, 0 }, { 0xaa02, 0 },
+		{ 0xba1e, 0 }, { 0xfa1e, 0 }, { 0xba1e, 500 },
+		{ 0xa801, 0 }, { 0xe801, 0 }, { 0xa801, 300 },
+	};
+	u32 revision = readl(controls[4]);
+	u32 value;
+
+	if (!ty1208z_usb_revision_valid(revision))
+		return -ENODEV;
+
+	value = readl(controls[0]);
+	writel(value | TY_USB_CONTROLLER_RESETS, controls[0]);
+	udelay(200);
+	value = readl(controls[1]);
+	writel(value | TY_USB_PHY_RESETS, controls[1]);
+	udelay(200);
+	value = readl(controls[2]);
+	writel((value | 8U) & ~0x201U, controls[2]);
+	udelay(100);
+	value = readl(controls[1]);
+	writel(value | 3U, controls[1]);
+	udelay(300);
+	ty1208z_usb_phy_commands(controls[3], pll240, ARRAY_SIZE(pll240));
+	value = readl(controls[1]);
+	writel(value & ~TY_USB_PHY_POWER_RESETS, controls[1]);
+	udelay(300);
+	if ((revision & 0xf0) == 0x10) {
+		udelay(2000);
+		ty1208z_usb_phy_commands(controls[3], revision10, ARRAY_SIZE(revision10));
+	} else {
+		ty1208z_usb_phy_commands(controls[3], other_revision,
+					ARRAY_SIZE(other_revision));
+	}
+	value = readl(controls[1]);
+	writel(value & ~TY_USB_PHY_PORT_RESETS, controls[1]);
+	udelay(2000);
+	value = readl(controls[0]);
+	writel((value & ~TY_USB_CONTROLLER_RESETS) | TY_USB_CONTROLLER_CLOCKS,
+	       controls[0]);
+	udelay(200);
+
+	/* Fail before a generic HCD can touch its registers or start DMA. */
+	if ((readl(controls[0]) & (TY_USB_CONTROLLER_RESETS | TY_USB_CONTROLLER_CLOCKS)) !=
+	    TY_USB_CONTROLLER_CLOCKS ||
+	    (readl(controls[1]) & (TY_USB_PHY_RESETS | 3U)) != 3U ||
+	    (readl(controls[2]) & 0x209U) != 8U) {
+		ty1208z_usb_host0_stop(controls);
+		return -EIO;
+	}
+	return 0;
+}
+#endif
--- /dev/null
+++ b/drivers/clocksource/timer-hi3798mv100.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Single-core diagnostic timer for Hi3798MV100.
+ * Register facts and the repeated event LOAD write follow the pinned vendor
+ * hisp804 reference. This driver intentionally does not enable other CPUs or
+ * touch clock gates, secure registers, OTP, storage or bootloader state.
+ * The upstream "hisilicon,sp804" binding describes a different 64-bit layout.
+ */
+#define pr_fmt(fmt) "hi3798mv100-timer: " fmt
+
+#include <linux/clk.h>
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/of_address.h>
+#include <linux/of_clk.h>
+#include <linux/of_irq.h>
+#include <linux/sched_clock.h>
+
+#include "timer-sp.h"
+
+static void __iomem *mv100_source;
+static void __iomem *mv100_event;
+static unsigned long mv100_reload;
+
+static u64 notrace mv100_sched_read(void)
+{
+	return (u32)~readl_relaxed(mv100_source + TIMER_VALUE);
+}
+
+static int mv100_shutdown(struct clock_event_device *evt)
+{
+	writel(0, mv100_event + TIMER_CTRL);
+	return 0;
+}
+
+static void mv100_program(unsigned long count, unsigned long mode)
+{
+	writel(TIMER_CTRL_32BIT, mv100_event + TIMER_CTRL);
+	/* Preserve the vendor hardware workaround until physical validation. */
+	writel(count, mv100_event + TIMER_LOAD);
+	writel(count, mv100_event + TIMER_LOAD);
+	writel(TIMER_CTRL_32BIT | TIMER_CTRL_IE | TIMER_CTRL_ENABLE | mode,
+	       mv100_event + TIMER_CTRL);
+}
+
+static int mv100_periodic(struct clock_event_device *evt)
+{
+	mv100_program(mv100_reload, TIMER_CTRL_PERIODIC);
+	return 0;
+}
+
+static int mv100_next_event(unsigned long next, struct clock_event_device *evt)
+{
+	mv100_program(next, TIMER_CTRL_ONESHOT);
+	return 0;
+}
+
+static struct clock_event_device mv100_clkevt = {
+	.name = "hi3798mv100-cpu0",
+	.rating = 400,
+	.features = CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	.set_state_shutdown = mv100_shutdown,
+	.set_state_oneshot = mv100_shutdown,
+	.set_state_periodic = mv100_periodic,
+	.tick_resume = mv100_shutdown,
+	.set_next_event = mv100_next_event,
+};
+
+static irqreturn_t mv100_interrupt(int irq, void *dev_id)
+{
+	struct clock_event_device *evt = dev_id;
+
+	writel(1, mv100_event + TIMER_INTCLR);
+	evt->event_handler(evt);
+	return IRQ_HANDLED;
+}
+
+static int __init mv100_timer_init(struct device_node *node)
+{
+	struct clk *clk;
+	unsigned long rate;
+	int ret, irq;
+
+	clk = of_clk_get(node, 0);
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	ret = clk_prepare_enable(clk);
+	if (ret)
+		goto put_clk;
+	rate = clk_get_rate(clk);
+	if (!rate) {
+		ret = -EINVAL;
+		goto disable_clk;
+	}
+	mv100_source = of_iomap(node, 0);
+	mv100_event = of_iomap(node, 1);
+	if (!mv100_source || !mv100_event) {
+		ret = -ENXIO;
+		goto unmap;
+	}
+	irq = irq_of_parse_and_map(node, 0);
+	if (irq <= 0) {
+		ret = -EINVAL;
+		goto unmap;
+	}
+	writel(0, mv100_source + TIMER_CTRL);
+	writel(0, mv100_event + TIMER_CTRL);
+	writel(1, mv100_event + TIMER_INTCLR);
+	ret = request_irq(irq, mv100_interrupt, IRQF_TIMER,
+			  mv100_clkevt.name, &mv100_clkevt);
+	if (ret)
+		goto unmap;
+
+	writel(0xffffffff, mv100_source + TIMER_LOAD);
+	writel(TIMER_CTRL_32BIT | TIMER_CTRL_ENABLE | TIMER_CTRL_PERIODIC,
+	       mv100_source + TIMER_CTRL);
+	ret = clocksource_mmio_init(mv100_source + TIMER_VALUE,
+			"hi3798mv100", rate, 499, 32, clocksource_mmio_readl_down);
+	if (ret) {
+		writel(0, mv100_source + TIMER_CTRL);
+		free_irq(irq, &mv100_clkevt);
+		goto unmap;
+	}
+	sched_clock_register(mv100_sched_read, 32, rate);
+	mv100_clkevt.irq = irq;
+	mv100_clkevt.cpumask = cpumask_of(0);
+	mv100_reload = DIV_ROUND_CLOSEST(rate, HZ);
+	clockevents_config_and_register(&mv100_clkevt, rate, 0xf, 0x7fffffff);
+	pr_info("single CPU, %lu Hz, source/event mapped, IRQ %d\n", rate, irq);
+	return 0;
+
+unmap:
+	if (mv100_event)
+		iounmap(mv100_event);
+	if (mv100_source)
+		iounmap(mv100_source);
+disable_clk:
+	clk_disable_unprepare(clk);
+put_clk:
+	clk_put(clk);
+	return ret;
+}
+TIMER_OF_DECLARE(hi3798mv100, "hisilicon,hi3798mv100-timer", mv100_timer_init);
