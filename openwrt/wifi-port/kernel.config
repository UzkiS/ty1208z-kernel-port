# Use native 6.12 cfg80211, not the optional OpenWrt backports package.
CONFIG_CFG80211=y
# Pin newly reachable native cfg80211 prompts; OpenWrt normally uses backports.
# CONFIG_NL80211_TESTMODE is not set
# CONFIG_CFG80211_DEVELOPER_WARNINGS is not set
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_CFG80211_DEFAULT_PS=y
CONFIG_CFG80211_CRDA_SUPPORT=y
# CONFIG_CFG80211_WEXT is not set
# CONFIG_VIRT_WIFI is not set
# CONFIG_PKCS8_PRIVATE_KEY_PARSER is not set
# CONFIG_PKCS7_TEST_KEY is not set
# CONFIG_FIPS_SIGNATURE_SELFTEST is not set
# CONFIG_SYSTEM_EXTRA_CERTIFICATE is not set
# CONFIG_SECONDARY_TRUSTED_KEYRING is not set
CONFIG_FW_LOADER=y
CONFIG_MODULES=y
# Preserve the real USB modalias and dependency metadata for package auditing.
# CONFIG_MODULE_STRIPPED is not set
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_WERROR=y
# CONFIG_DEBUG_FS is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_XHCI_HCD is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_BLOCK is not set
# CONFIG_SMP is not set
