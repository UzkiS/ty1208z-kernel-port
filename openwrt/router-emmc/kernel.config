CONFIG_LOCALVERSION="-ty1208z-openwrt-emmcro"
CONFIG_TY1208Z_ROUTER_EMMC_RO=y
# CONFIG_TY1208Z_ROUTER_RAM768 is not set
# CONFIG_TY1208Z_ROUTER_SD_RO is not set
# CONFIG_HIGHMEM is not set
# CONFIG_WATCHDOG is not set
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_HI3798MV100_IDENT=y
CONFIG_HI3798MV100_EMMC_READ_ONLY=y
CONFIG_BLOCK=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=16
CONFIG_PARTITION_ADVANCED=y
CONFIG_CMDLINE_PARTITION=y
# CONFIG_OF_PARTITION is not set
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set
CONFIG_EXT4_FS=y
# CONFIG_EXT4_FS_POSIX_ACL is not set
# CONFIG_EXT4_FS_SECURITY is not set
# CONFIG_FS_ENCRYPTION is not set
# CONFIG_FS_VERITY is not set
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_TY1208Z_MV100_EMMC_RO=y
# CONFIG_POWER_RESET_TY1208Z_MV100_SD is not set
# CONFIG_HI3798MV100_EMMC_READ_SAMPLES is not set
# CONFIG_MMC_DW_HI3798MV100_SD_IDENT is not set
# CONFIG_HI3798MV100_SD_READ_ONLY is not set
# CONFIG_MMC_DW_BLUEFIELD is not set
# CONFIG_MMC_DW_EXYNOS is not set
# CONFIG_MMC_DW_HI3798CV200 is not set
# CONFIG_MMC_DW_HI3798MV200 is not set
# CONFIG_MMC_DW_K3 is not set
# CONFIG_MMC_TEST is not set
# CONFIG_PWRSEQ_EMMC is not set
# CONFIG_PWRSEQ_SIMPLE is not set
# CONFIG_BLK_DEV is not set
# CONFIG_BLK_DEV_WRITE_MOUNTED is not set
# CONFIG_BLK_DEV_BSG is not set
# CONFIG_BLK_DEV_INTEGRITY is not set
# CONFIG_BLK_DEV_ZONED is not set
# CONFIG_BLK_DEV_THROTTLING is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PM is not set
