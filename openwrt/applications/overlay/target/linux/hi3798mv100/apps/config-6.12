CONFIG_CRYPTO_CRC32C=y
CONFIG_FAILOVER=y
CONFIG_LIBCRC32C=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_BPF_LINK=y
CONFIG_NETFILTER_FAMILY_ARP=y
CONFIG_NETFILTER_FAMILY_BRIDGE=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NET_FAILOVER=y
