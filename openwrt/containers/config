CONFIG_TARGET_hi3798mv100_apps=y
CONFIG_TARGET_hi3798mv100_apps_DEVICE_ty1208z_apps=y
# CONFIG_TARGET_hi3798mv100_ram is not set
# CONFIG_TARGET_hi3798mv100_ram_DEVICE_ty1208z_ca_ram is not set
CONFIG_TARGET_ROOTFS_INITRAMFS_SEPARATE=y
# Packages are compiled independently; they are not placed in a RAM rootfs.
CONFIG_PACKAGE_docker=m
CONFIG_PACKAGE_dockerd=m
CONFIG_PACKAGE_containerd=m
CONFIG_PACKAGE_runc=m
CONFIG_PACKAGE_tini=m
# Docker's iptables-nft provider also needs the nft NAT chain/expression modules.
CONFIG_PACKAGE_kmod-nft-nat=m
CONFIG_KERNEL_SECCOMP=y
CONFIG_KERNEL_SECCOMP_FILTER=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_UTS_NS=y
CONFIG_KERNEL_IPC_NS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_USER_NS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_CGROUP_SCHED=y
CONFIG_KERNEL_FAIR_GROUP_SCHED=y
CONFIG_KERNEL_CFS_BANDWIDTH=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_BLK_CGROUP=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
