# Compile-only package dependency kernel. No board storage driver is enabled.
CONFIG_LOCALVERSION="-ty1208z-container-compile"
CONFIG_BLOCK=y
# CONFIG_VIRTIO_BLK is not set
# CONFIG_MMC is not set
# CONFIG_MTD is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_SMP is not set
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
