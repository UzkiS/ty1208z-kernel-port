CONFIG_TARGET_hi3798mv100=y
CONFIG_TARGET_hi3798mv100_ram=y
CONFIG_TARGET_hi3798mv100_ram_DEVICE_ty1208z_ca_ram=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_GZIP=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_CPIOGZ=y
CONFIG_PACKAGE_ty1208z-time64=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_STAT=y
CONFIG_BUSYBOX_CONFIG_FEATURE_STAT_FORMAT=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_CCACHE=y
CONFIG_PACKAGE_mtd=n
CONFIG_PACKAGE_procd-ujail=n
CONFIG_USE_SECCOMP=n
CONFIG_KERNEL_SECCOMP=n
CONFIG_KERNEL_NAMESPACES=n
CONFIG_KERNEL_PRINTK_TIME=y
CONFIG_KERNEL_KALLSYMS=y
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n
CONFIG_KERNEL_DEBUG_KERNEL=n
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mcpu=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard"
