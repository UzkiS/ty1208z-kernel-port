#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck disable=SC2034
START=12

start() {
	[ -f /etc/ty1208z-grow-p9 ] || return 0
	[ "$(cat /sys/class/block/mmcblk0p9/start)" = 1249280 ] || return 1
	[ "$(cat /sys/class/block/mmcblk0p9/size)" = 14020608 ] || return 1
	awk '$3 == "179:9" && $5 == "/" { ok=1 } END { exit !ok }' /proc/self/mountinfo || return 1
	[ "$(cat /sys/class/block/mmcblk0p9/ro)" = 0 ] || return 1
	# Older candidates advertise erase-based zeroout despite denying erase.
	# Do not retry growth until the corrected bounded-write kernel is running.
	[ "$(cat /sys/class/block/mmcblk0/queue/write_zeroes_max_bytes)" = 0 ] || return 1
	[ "$(cat /sys/class/block/mmcblk0/queue/discard_max_bytes)" = 0 ] || return 1
	# The kernel lists the root as /dev/root; devtmpfs does not create that alias.
	# e2fsprogs must resolve it to recognize the mounted p9 and use online resize.
	if [ ! -e /dev/root ] && [ ! -L /dev/root ]; then
		ln -s mmcblk0p9 /dev/root || return 1
	fi
	[ "$(readlink -f /dev/root)" = /dev/mmcblk0p9 ] || return 1
	/sbin/resize2fs /dev/mmcblk0p9 1752576 || return 1
	rm /etc/ty1208z-grow-p9
	sync
}
