CONFIG_LOCALVERSION="-ty1208z-diag1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_EXPERT=y
CONFIG_MMU=y
# CONFIG_ARCH_MULTI_V4 is not set
# CONFIG_ARCH_MULTI_V4T is not set
# CONFIG_ARCH_MULTI_V5 is not set
# CONFIG_ARCH_MULTI_V6 is not set
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_HISI=y
CONFIG_ARCH_HI3798MV100=y
# Same raw zImage can be tested using QEMU virt's unrelated DTB.
CONFIG_ARCH_VIRT=y
# CONFIG_SMP is not set
# CONFIG_HIGHMEM is not set
# CONFIG_MODULES is not set
# CONFIG_BLOCK is not set
# CONFIG_NET is not set
# CONFIG_MMC is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MTD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_DRM is not set
# CONFIG_SOUND is not set
# CONFIG_INPUT is not set
# CONFIG_HWMON is not set
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_PCI is not set
CONFIG_AEABI=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_AUTO_ZRELADDR=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SYSCTL=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_KERNEL_GZIP=y
CONFIG_ARM_APPENDED_DTB=y
# Do not import an old ATAG memory size or Hinas root command line.
# CONFIG_ARM_ATAG_DTB_COMPAT is not set
CONFIG_CMDLINE=""
CONFIG_HZ_100=y
CONFIG_PREEMPT_NONE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_KERNEL=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
# CONFIG_DEBUG_INFO is not set
# CONFIG_TY1208Z_ROUTER_RAM768 is not set
