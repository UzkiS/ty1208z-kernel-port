# Independent full module build; does not enable Wi-Fi in RAM diagnostics.
CONFIG_LOCALVERSION="-ty1208z-wifi-port"
CONFIG_INITRAMFS_SOURCE=""
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_FW_LOADER=y
# CONFIG_DEBUG_FS is not set
