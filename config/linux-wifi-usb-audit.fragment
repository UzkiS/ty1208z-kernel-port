# Optional compile-only audit. Never merge this into the RAM diagnostic config.
CONFIG_LOCALVERSION="-ty1208z-wifi-usb-audit"
CONFIG_INITRAMFS_SOURCE=""
CONFIG_MODULES=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_FW_LOADER=y
