#!/bin/sh
export PATH=/bin:/sbin
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /tmp
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
echo
echo 'TY1208Z: Linux 6.12 RAM candidate; see the profile-specific hardware report.'
case "$(uname -r)" in
    *-usb-host1)
        echo 'USB host0 enumeration experiment; network/storage/class drivers disabled.'
        echo 'Run usb-diag for descriptor observations; no firmware is loaded.'
        echo 'rda-usb-identity --probe performs three fixed identity queries only when explicitly invoked.'
        ;;
    *-ethernet-net1)
        echo 'Single core; inherited-PHY Ethernet experiment; storage disabled.'
        echo 'Network is down by default. ethernet-diag --dhcp requests a temporary lease.'
        ;;
    *) echo 'Single core; network drivers disabled; root is RAM only.' ;;
esac
uname -a
cat /proc/cmdline
head -n 5 /proc/meminfo
cat /sys/devices/system/clocksource/clocksource0/current_clocksource
/bin/time64-probe
echo 'Run diag to capture IRQ/timer/memory information.'

# Only QEMU virt regression runs use this exact command-line token.
# Board DTB does not include it. Future-date test never runs by default.
# Kernel command line is intentionally scanned as words, not input lines.
# shellcheck disable=SC2013
for arg in $(cat /proc/cmdline); do
    if [ "$arg" = 'ty1208z.qemu_selftest=1' ]; then
        if ! grep -q 'linux,dummy-virt' /sys/firmware/devicetree/base/compatible; then
            echo 'QEMU_SELFTEST_REFUSED: board is not the virt machine'
            break
        fi
        case "$(uname -r)" in
            *-ram768)
                # Exercise the actual ARM mount/shell and low-memory denial.
                # The 256-MiB QEMU guest must not allocate the physical test's file.
                if /bin/ram768-diag; then
                    echo RAM768_QEMU_LOW_MEMORY_DENIAL_FAIL
                elif ! grep -q ' /tmp/ram768-area ' /proc/mounts &&
                     test ! -e /tmp/ram768-area/memory-test; then
                    echo RAM768_QEMU_LOW_MEMORY_DENIAL_PASS
                else
                    echo RAM768_QEMU_LOW_MEMORY_DENIAL_FAIL
                fi
                ;;
            *-usb-host1)
                /bin/usb-diag || echo USB_HOST0_OBSERVER_FAIL
                if [ -x /bin/rda-usb-identity ]; then
                    /bin/rda-usb-identity --selftest || echo RDA_USB_IDENTITY_SELFTEST_FAIL
                fi
                ;;
        esac
        clock_ok=0
        /bin/time64-probe --set-clock-2040 && clock_ok=1
        year=$(date -u +%Y)
        touch /tmp/busybox-2040
        file_epoch=$(stat -c %Y /tmp/busybox-2040)
        echo "BusyBox future-date readback: year=$year file_epoch=$file_epoch"
        if [ "$clock_ok" = 1 ] && [ "$year" = 2040 ] &&
           [ "$file_epoch" -gt 2147483647 ] &&
           [ "$(stat -c %X /tmp/busybox-2040)" -gt 2147483647 ] &&
           [ "$(stat -c %Z /tmp/busybox-2040)" -gt 2147483647 ]; then
            /bin/sh -c 'echo QEMU_ARM_SHELL_PASS'
            date -u
            stat /tmp/busybox-2040
            echo 'QEMU_INITRAMFS_TIME64_PASS'
        else
            echo 'QEMU_INITRAMFS_TIME64_FAIL'
        fi
        sync
        poweroff -f
    fi
done

while :; do
    setsid cttyhack /bin/sh
    echo 'Diagnostic shell exited; restarting it.'
    sleep 1
done
